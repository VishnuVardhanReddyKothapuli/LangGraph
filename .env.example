# Set either key; set both for automatic fallback. Never commit .env.
GOOGLE_API_KEY=
GROQ_API_KEY=
PRIMARY_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Empty URL uses embedded Qdrant on disk (no Docker needed).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=folio_documents
FASTEMBED_CACHE_PATH=./data/models
